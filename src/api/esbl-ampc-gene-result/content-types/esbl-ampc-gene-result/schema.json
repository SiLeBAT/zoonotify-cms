{
  "kind": "collectionType",
  "collectionName": "esbl_ampc_gene_results",
  "info": {
    "singularName": "esbl-ampc-gene-result",
    "pluralName": "esbl-ampc-gene-results",
    "displayName": "ESBL/AmpC Gene Result",
    "description": "Occurrence of one ESBL/AmpC gene for one combination, sampling year and monitoring."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "zomoProgram": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "private": true
    },
    "microorganism": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::microorganism.microorganism"
    },
    "sampleType": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sample-type.sample-type"
    },
    "superCategorySampleOrigin": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::super-category-sample-origin.super-category-sample-origin"
    },
    "sampleOrigin": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sample-origin.sample-origin"
    },
    "samplingStage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sampling-stage.sampling-stage"
    },
    "matrixGroup": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix-group.matrix-group"
    },
    "matrix": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix.matrix"
    },
    "matrixDetail": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix-detail.matrix-detail"
    },
    "monitoring": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::monitoring.monitoring"
    },
    "esblAmpcGene": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::esbl-ampc-gene.esbl-ampc-gene"
    },
    "samplingYear": {
      "type": "integer",
      "required": true
    },
    "numberOfIsolates": {
      "type": "integer",
      "required": true
    },
    "numberOfGenes": {
      "type": "integer",
      "required": true
    },
    "numberOfIsolatesWithGene": {
      "type": "integer",
      "required": true
    },
    "relativeGeneAbundance": {
      "type": "float",
      "required": true
    },
    "relativeGeneAbundanceCiMin": {
      "type": "float",
      "required": true
    },
    "relativeGeneAbundanceCiMax": {
      "type": "float",
      "required": true
    },
    "genePrevalence": {
      "type": "float",
      "required": true
    },
    "genePrevalenceCiMin": {
      "type": "float",
      "required": true
    },
    "genePrevalenceCiMax": {
      "type": "float",
      "required": true
    },
    "dataExtractionDate": {
      "type": "date"
    },
    "dbId": {
      "type": "string",
      "required": true,
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
