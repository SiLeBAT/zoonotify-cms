{
  "kind": "collectionType",
  "collectionName": "multi_resistances",
  "info": {
    "singularName": "multi-resistance",
    "pluralName": "multi-resistances",
    "displayName": "Multi-resistance",
    "description": "Isolate counts per resistance group (susceptible, 1x ... >4x resistant) for one combination and sampling year"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "zomoProgram": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "private": true
    },
    "microorganism": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::microorganism.microorganism"
    },
    "specie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::specie.specie"
    },
    "superCategorySampleOrigin": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::super-category-sample-origin.super-category-sample-origin"
    },
    "sampleOrigin": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sample-origin.sample-origin"
    },
    "samplingStage": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sampling-stage.sampling-stage"
    },
    "matrixGroup": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix-group.matrix-group"
    },
    "matrix": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix.matrix"
    },
    "matrixDetail": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::matrix-detail.matrix-detail"
    },
    "samplingYear": {
      "type": "integer",
      "required": true
    },
    "resistanceGroup": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 5
    },
    "anzahlIsolate": {
      "type": "integer",
      "required": true
    },
    "anzahlGetesteterIsolate": {
      "type": "integer",
      "required": true
    },
    "dbId": {
      "type": "string",
      "required": true,
      "private": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
